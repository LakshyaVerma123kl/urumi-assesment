# LLM Provider Configuration
# Supported: gemini, groq
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Groq Alternative (if LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk_your_groq_key_here

# WooCommerce Connection (optional — mock store used if unavailable)
# WC_URL=http://localhost:8080
# WC_CONSUMER_KEY=ck_your_key
# WC_CONSUMER_SECRET=cs_your_secret
